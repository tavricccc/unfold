{
  "name": "unfold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "check": "bun tests/expr.check.ts && bun tests/partial.check.ts && bun tests/kit.check.ts && bun tests/refs.check.ts",
    "build:agent": "bun build --compile --minify --target=bun-windows-x64 sidecar/agent.ts --outfile src-tauri/binaries/unfold-agent-x86_64-pc-windows-msvc.exe"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2",
    "mafs": "^0.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}

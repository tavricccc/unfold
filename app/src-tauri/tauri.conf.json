{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Unfold",
  "version": "0.1.0",
  "identifier": "app.unfold.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:agent && bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Unfold",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "'self' about: data: blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "script-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/unfold-agent"
    ],
    "shortDescription": "Unfold",
    "longDescription": "Ask a question and get an interactive lesson, written by your own Claude Code.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "TradChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1QzE3QTk0QTRERTYyQUQKUldTdFl0NmtsSHJCaFhiWjJ5eWhuM05Qa1VIakphWmtMRXN3YTVWMHhLekZuOFQ0Qy8yZlF3TTQK",
      "endpoints": [
        "https://github.com/tavricccc/unfold/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

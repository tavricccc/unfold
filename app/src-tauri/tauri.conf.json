{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Unfold",
  "version": "0.1.0",
  "identifier": "app.unfold.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:agent && bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Unfold",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/unfold-agent"
    ],
    "shortDescription": "Unfold",
    "longDescription": "Ask a question and get an interactive lesson, written by your own Claude Code.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "TradChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
